{
  "name": "@inkredabull/career-catalyst-networker",
  "version": "1.0.0",
  "description": "Unified LinkedIn networking CLI — discovery, outreach, and lifecycle tracking",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "networker": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "watch": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "linkedin",
    "networking",
    "cli",
    "outreach"
  ],
  "author": "Anthony Bull",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.12.2",
    "commander": "^14.0.1",
    "dotenv": "^17.2.3",
    "openai": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
