# EnrichLayer API (profile lookup)
ENRICHLAYER_API_TOKEN=your_enrichlayer_token_here

# Anthropic API (message variant generation)
ANTHROPIC_API_KEY=sk-ant-your_key_here

# OpenAI API (optional: condense profile summaries to 4 words)
OPENAI_API_KEY=your_openai_key_here

# City used when searching for profiles (default: San Francisco)
SEARCH_CITY=San Francisco

# LinkedIn connection message template for discover/send workflow
# Available tokens: {{firstName}}, {{summary}}, {{event}}
LINKEDIN_MESSAGE_TEMPLATE=Hi {{firstName}}, looking forward to connecting!

# Path to the tracker JSON file (default: ./data/tracker.json)
# NETWORKER_TRACKER_FILE=./data/tracker.json

# Your own full name — excluded from discover results so you don't look yourself up
NETWORKER_OWN_NAME=Anthony Bull
