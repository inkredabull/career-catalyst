{
  "name": "@inkredabull/career-catalyst-sms-bridge",
  "version": "1.0.0",
  "description": "Local HTTP bridge that sends SMS/iMessage through macOS Messages.app, and fronts unified-server behind a single ngrok tunnel",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "prebuild": "npm run clean",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "sms",
    "imessage",
    "applescript",
    "macos",
    "bridge"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
