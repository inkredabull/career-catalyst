# EnrichLayer API Bearer Token
# Get your token from https://enrichlayer.com
ENRICHLAYER_API_TOKEN=your_token_here

# City to filter searches (default: San Francisco)
# Note: Quotes will be added automatically by the code
SEARCH_CITY=San Francisco

# Batch size per run (recommended range: 10-15, default: 12)
BATCH_SIZE=12

# Tiered prioritization patterns (case-insensitive regex)
# Tier 1: highest priority (investors + C-suite)
TARGET_TIER_1_PATTERN=Managing\s+Partner|General\s+Partner|\bPartner\b|\bVC\b|Venture\s+Capital|\bInvestor\b|\bCapital\b|C[TEOFMPI]O|Chief\s+\w+\s+Officer

# Tier 2: strong follow-up candidates (leadership/operators)
TARGET_TIER_2_PATTERN=Vice\s+President|\bVP\b|\bVPE\b|Head\s+of|\bPrincipal\b|\bDirector\b|DIR\s+ENG|Founder|Co-?Founder

# Tier 3: optional long-tail follow-up (leave empty to disable)
TARGET_TIER_3_PATTERN=

# Legacy fallback pattern (kept for backwards compatibility)
TARGET_CONTACT_PATTERN=Partner|Capital|VC|Investor|C[TEOFMPI]O|Chief\s+\w+\s+Officer|VP|VPE|Director|DIR\s+ENG
