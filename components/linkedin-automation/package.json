{
  "name": "@inkredabull/career-catalyst-linkedin-automation",
  "version": "1.0.0",
  "description": "LinkedIn Chrome automation — connect scripts, follow scripts, message templating, and company sheet logging",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
