# ============================================
# Non-secret config → career-catalyst.config.json
# ============================================
# Model names, token limits, file paths, and feature flags live in
# career-catalyst.config.json (committed). Override any of them here
# if you need a machine-specific value that differs from the defaults.
#
# Keys you can override here (see config file for defaults):
#   RESUME_LLM_PROVIDER, RESUME_LLM_MODEL
#   CRITIQUE_LLM_PROVIDER, CRITIQUE_LLM_MODEL
#   JOB_AGENT_LLM_MODEL, OPENAI_TEMPERATURE, OPENAI_MAX_TOKENS
#   ANTHROPIC_MODEL, ANTHROPIC_MAX_TOKENS
#   MAX_ROLES, CRITIQUE_AND_JUDGE_MAX_ATTEMPTS
#   LLM_AUTO_CONFIRM, CV_PATH, RESUME_OUTPUT_DIR
#   AUTO_RESUME_THRESHOLD, AUTO_RESUME_CV_PATH
#   NOTIFICATION_EMAIL, LANGSMITH_ENDPOINT

# ============================================
# Secrets (REQUIRED — never put these in config.json)
# ============================================

# API Keys (provide key for your chosen provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Gemini API Key (free — for auto-generating job blurbs on track)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# LangSmith API key (optional, for evaluation and monitoring)
LANGSMITH_API_KEY=your_langsmith_api_key_here

# Profile Configuration (sensitive)
MIN_SALARY=200000

# Teal Integration
TEAL_EMAIL=your_teal_email@example.com
TEAL_PASSWORD=your_teal_password

# Google API Configuration (for Gmail, Sheets, and Drive integration)
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
# Must include the drive.readonly scope (in addition to gmail.readonly) to auto-resolve
# résumé Drive share links - re-run scripts/setup-gmail-auth.js to mint one with both scopes.
GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# Google Sheets Job Tracking (optional)
GOOGLE_SHEETS_ENABLED=true
GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID
GOOGLE_SHEETS_SHEET_NAME=Sheet1

# Mutual Connections → Google Sheet (service account auth)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","client_email":"...","private_key":"..."}
MUTUAL_CONNECTIONS_SPREADSHEET_ID=<get id from the sheet>
MUTUAL_CONNECTIONS_SHEET_NAME=<exact tab name from the sheet>
JINA_API_KEY=<your jina key>

# ngrok tunnel URL for the local unified-server (components/unified-server).
# Shared by components/alerts (JD-extractor tracking links, via Vercel env var
# of the same name — must be updated there too) and components/mail-merge
# (SMS webhook + job metadata fetch, read from this root .env at build time).
# ngrok free-tier URLs are ephemeral — update this whenever the tunnel restarts.
NGROK_TUNNEL_URL=https://xxxx-xx-xxx-xxx-xx.ngrok-free.app
