# Shared secret guarding POST /send on components/unified-server.
#
# Copy this file to .sms-bridge-secret (gitignored) and put a real random
# token on the single non-comment line below. Generate one with:
#
#   openssl rand -hex 32
#
# Blank lines and #-comments are ignored; the first remaining line is the
# secret.
#
# Callers must send it as the X-SMS-Bridge-Token request header.
# components/mail-merge bundles it at build time, so after changing this you
# must rebuild and redeploy that component:
#
#   npm run deploy --workspace=@inkredabull/career-catalyst-mail-merge
#
# SMS_BRIDGE_SECRET in the environment takes precedence over this file.

replace-me-with-openssl-rand-hex-32
